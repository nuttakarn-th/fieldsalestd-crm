{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/s/:code", "destination": "/api/s?c=:code" },
    { "source": "/:code([0-9][A-Za-z0-9][A-Za-z0-9])", "destination": "/api/s?c=:code" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
