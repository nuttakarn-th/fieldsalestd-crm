{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/0:rest", "destination": "/api/s?c=0:rest" },
    { "source": "/1:rest", "destination": "/api/s?c=1:rest" },
    { "source": "/2:rest", "destination": "/api/s?c=2:rest" },
    { "source": "/3:rest", "destination": "/api/s?c=3:rest" },
    { "source": "/4:rest", "destination": "/api/s?c=4:rest" },
    { "source": "/5:rest", "destination": "/api/s?c=5:rest" },
    { "source": "/6:rest", "destination": "/api/s?c=6:rest" },
    { "source": "/7:rest", "destination": "/api/s?c=7:rest" },
    { "source": "/8:rest", "destination": "/api/s?c=8:rest" },
    { "source": "/9:rest", "destination": "/api/s?c=9:rest" },
    { "source": "/s/:code", "destination": "/api/s?c=:code" },

    { "source": "/catalog",           "missing": [{ "type": "query", "key": "_r" }], "destination": "/api/og-page?path=catalog" },
    { "source": "/war-room",          "missing": [{ "type": "query", "key": "_r" }], "destination": "/api/og-page?path=war-room" },
    { "source": "/tour-packages",     "missing": [{ "type": "query", "key": "_r" }], "destination": "/api/og-page?path=tour-packages" },
    { "source": "/tour-presentation", "missing": [{ "type": "query", "key": "_r" }], "destination": "/api/og-page?path=tour-presentation" },
    { "source": "/present/:id",       "missing": [{ "type": "query", "key": "_r" }], "destination": "/api/og-page?path=present&id=:id" },

    { "source": "/:path*", "destination": "/index.html" }
  ]
}
